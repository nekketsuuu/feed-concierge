#!/usr/bin/env ruby
require_relative "../lib/feed_concierge"

store_path = ENV.fetch("FEED_CONCIERGE_STORE", File.join(FeedConcierge::ROOT, "data", "scores.json"))
output_dir = ENV.fetch("FEED_CONCIERGE_OUTPUT", File.join(FeedConcierge::ROOT, "site"))

client =
  if ENV["FEED_CONCIERGE_FAKE_JEV"]
    warn "FEED_CONCIERGE_FAKE_JEV is set: using fake answers, no API calls"
    FeedConcierge::FakeJevClient.new
  elsif ENV["TYPESAFE_AI_API_KEY"].to_s.empty?
    abort "TYPESAFE_AI_API_KEY is not set (or set FEED_CONCIERGE_FAKE_JEV=1 for a dry run)"
  else
    FeedConcierge::JevClient.new(model: FeedConcierge.settings["model"])
  end

FeedConcierge::Pipeline.new(store_path: store_path, output_dir: output_dir, client: client).run
