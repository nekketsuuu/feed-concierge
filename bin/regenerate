#!/usr/bin/env ruby
# frozen_string_literal: true

# Rebuilds the page from cached judgments without fetching feeds or calling Jev.
# Useful when tuning config/settings.yml ranking weights.
require_relative "../lib/feed_concierge"

store = FeedConcierge::Store.new(ENV.fetch("FEED_CONCIERGE_STORE", File.join(FeedConcierge::ROOT, "data", "scores.json")))
output_dir = ENV.fetch("FEED_CONCIERGE_OUTPUT", File.join(FeedConcierge::ROOT, "site"))
ranked = FeedConcierge::Ranker.new(FeedConcierge.settings["ranking"]).rank(store)
settings = FeedConcierge.settings
site = FeedConcierge::Site.new(output_dir, site: settings.fetch("site"), tag_config: settings.fetch("tags"))
site.build(ranked, generated_at: Time.now, judged_count: store.each_article.size)
ranked.each_with_index do |r, i|
  puts format("%2d %.3f rel=%.2f fresh=%.2f exp=%.2f  %s", i + 1, r.score, r.relevance, r.freshness, r.exposure, r.article.title)
end
