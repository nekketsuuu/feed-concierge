<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.2em; margin: 0; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
  footer { color: var(--muted); font-size: .75em; margin-top: 1.5rem; }
  /* Debug view (?debug=1): one hue for 0..1 magnitudes, track = lighter step of the same ramp. */
  :root { --bar-fill: #2a78d6; --bar-track: #cde2fb; --bar-mark: #0b0b0b; }
  @media (prefers-color-scheme: dark) { :root { --bar-fill: #3987e5; --bar-track: #0d366b; --bar-mark: #ffffff; } }
  .dbg { margin: .35rem 0 .2rem 1rem; font-size: .78em; color: var(--muted); }
  .dbg-score { color: inherit; font-weight: 600; }
  .dbg-h { margin-top: .35rem; }
  .dbg-grid { display: grid; grid-template-columns: 11em 160px auto; column-gap: .6rem; row-gap: 3px; align-items: center; margin-top: .15rem; }
  .dbg-grid span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
  .bar { position: relative; height: 8px; background: var(--bar-track); border-radius: 0 4px 4px 0; }
  .bar i { display: block; height: 100%; background: var(--bar-fill); border-radius: 0 4px 4px 0; }
  .bar b { position: absolute; top: -2px; bottom: -2px; width: 1px; background: var(--bar-mark); opacity: .6; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li data-id="<%= h(r.article.id) %>"><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= local(r.article.published_at).iso8601 %>"><%= date_label(r.article.published_at) %></time></span></li>
<%- end -%>
</ul>
<footer>Updated <time datetime="<%= local(generated_at).iso8601 %>"><%= datetime_label(generated_at) %></time> · <a href="<%= h(repository_url) %>"><%= h(repository_url.delete_prefix("https://")) %></a> · <a href="?debug=1">debug</a></footer>
<script>
  // ?debug=1 loads data.json and draws each article's score breakdown under it.
  if (new URLSearchParams(location.search).get("debug")) {
    const threshold = <%= @tag_config["min_probability"] %>;
    const f = n => Number(n).toFixed(2);
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const bar = (value, mark) => {
      const b = el("div", "bar"); b.title = f(value);
      const fill = el("i"); fill.style.width = `${Math.max(0, Math.min(1, value)) * 100}%`; b.appendChild(fill);
      if (mark != null) { const m = el("b"); m.style.left = `${mark * 100}%`; b.appendChild(m); }
      return b;
    };
    const grid = (rows, mark) => {
      const g = el("div", "dbg-grid");
      for (const [label, value, note] of rows) {
        g.appendChild(el("span", null, label)); g.appendChild(bar(value, mark)); g.appendChild(el("span", null, note ?? f(value)));
      }
      return g;
    };
    fetch("data.json").then(r => r.json()).then(rows => {
      for (const row of rows) {
        const li = document.querySelector(`li[data-id="${CSS.escape(row.id)}"]`);
        if (!li) continue;
        const j = row.judgment;
        const box = el("div", "dbg");
        const head = el("div");
        head.appendChild(el("span", "dbg-score", `score ${f(row.score)}`));
        head.appendChild(el("span", null, ` = relevance × freshness × exposure · ${row.source} · ${j.question_set} · ${Math.round(row.age_hours)}h`));
        box.appendChild(head);
        box.appendChild(grid([["relevance", row.relevance], ["freshness", row.freshness], ["exposure", row.exposure]]));
        box.appendChild(el("div", "dbg-h", "relevance = Σ value × weight"));
        box.appendChild(grid(row.components.map(c => [c.id, c.value, `${f(c.value)} × ${c.weight} = ${f(c.contribution)}`])));
        for (const key of Object.keys(j).filter(k => k.endsWith("_probabilities"))) {
          box.appendChild(el("div", "dbg-h", key.replace("_probabilities", "")));
          box.appendChild(grid(Object.entries(j[key]).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([o, p]) => [o, p])));
        }
        box.appendChild(el("div", "dbg-h", `tags (shown at ≥ ${threshold})`));
        box.appendChild(grid(Object.entries(row.tag_probabilities).map(([t, p]) => [t, p]), threshold));
        li.appendChild(box);
      }
    });
  }
</script>
</body>
</html>
