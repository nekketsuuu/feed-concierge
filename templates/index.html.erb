<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  header { display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap; }
  h1 { font-size: 1.2em; margin: 0; }
  header .meta { margin: 0; }
  header .meta a { color: inherit; text-decoration: none; }
  header .meta a:hover { text-decoration: underline; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
  <span class="meta">updated <time datetime="<%= local(generated_at).iso8601 %>"><%= datetime_label(generated_at) %></time> · <a href="<%= h(repository_url) %>">repo</a></span>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li data-score="<%= r.score.round(4) %>" data-url="<%= h(r.article.url) %>"><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= local(r.article.published_at).iso8601 %>"><%= date_label(r.article.published_at) %></time></span></li>
<%- end -%>
</ul>
<script>
  // Demotes articles seen before: clicked here, or scrolled past the top after being on screen
  // for a while. Remembered in localStorage.
  (() => {
    const KEY = "feed-concierge:seen", TTL_MS = <%= @site["seen_ttl_days"] %> * 86400e3, DWELL_MS = <%= @site["seen_dwell_ms"] %>;
    const PENALTY = { clicked: <%= @site["clicked_penalty"] %>, passed: <%= @site["passed_penalty"] %> };
    const now = Date.now();
    let seen = {};
    try { seen = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { seen = {}; }
    for (const [url, entry] of Object.entries(seen)) if (!(entry && entry.until > now)) delete seen[url];
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(seen)); } catch { /* storage unavailable */ } };
    const list = document.querySelector("ul");
    const items = [...list.children];
    if (items.some(li => seen[li.dataset.url])) {
      const order = items.map((li, i) => ({ li, i, score: Number(li.dataset.score) * (seen[li.dataset.url] ? PENALTY[seen[li.dataset.url].kind] ?? 1 : 1) }))
        .sort((a, b) => b.score - a.score || a.i - b.i);
      const fragment = document.createDocumentFragment();
      for (const { li } of order) fragment.appendChild(li);
      list.appendChild(fragment);
    }
    const mark = (url, kind) => { if (kind === "passed" && seen[url]?.kind === "clicked") return; seen[url] = { kind, until: now + TTL_MS }; save(); };
    const remember = event => {
      const li = event.target.closest("li");
      if (li && event.target.closest("a") && list.contains(li)) mark(li.dataset.url, "clicked");
    };
    list.addEventListener("click", remember, true);
    list.addEventListener("auxclick", remember, true);
    if (!("IntersectionObserver" in window)) return;
    // An article counts as passed when one continuous stay in the reading band (top part of the
    // viewport, tab visible) lasts long enough and ends by leaving through the top.
    const shownAt = new Map();
    const observer = new IntersectionObserver(entries => {
      const t = performance.now();
      for (const entry of entries) {
        const li = entry.target;
        if (entry.isIntersecting) { shownAt.set(li, t); continue; }
        const started = shownAt.get(li);
        shownAt.delete(li);
        if (started == null || document.visibilityState !== "visible") continue;
        if (entry.boundingClientRect.bottom < 0 && t - started >= DWELL_MS) { mark(li.dataset.url, "passed"); observer.unobserve(li); }
      }
    }, { rootMargin: "0px 0px -65% 0px" });
    document.addEventListener("visibilitychange", () => { const t = performance.now(); for (const li of shownAt.keys()) shownAt.set(li, t); });
    for (const li of items) observer.observe(li);
  })();
</script>
</body>
</html>
