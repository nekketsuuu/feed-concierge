<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.2em; margin: 0; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
  footer { color: var(--muted); font-size: .75em; margin-top: 1.5rem; }
  /* Debug view (?debug=1): one hue for 0..1 magnitudes, track = lighter step of the same ramp. */
  :root { --bar-fill: #2a78d6; --bar-track: #cde2fb; }
  @media (prefers-color-scheme: dark) { :root { --bar-fill: #3987e5; --bar-track: #0d366b; } }
  .dbg { margin: .35rem 0 .2rem 1rem; font-size: .78em; color: var(--muted); }
  .dbg-h { margin-top: .35rem; }
  .dbg-grid { display: grid; grid-template-columns: 11em 160px auto; column-gap: .6rem; row-gap: 3px; align-items: center; margin-top: .15rem; }
  .dbg-grid span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
  .bar { position: relative; height: 8px; background: var(--bar-track); border-radius: 0 4px 4px 0; }
  .bar i { display: block; height: 100%; background: var(--bar-fill); border-radius: 0 4px 4px 0; }
  .dbg-final { margin-top: .3rem; padding-bottom: .35rem; border-bottom: 1px solid rgba(127,127,127,.25); }
  .dbg-final span { color: inherit; font-weight: 600; }
  .dbg-final .bar { height: 14px; }
  .slots { margin: .15rem 0 0; }
  .slots-bars, .slots-labels { display: flex; gap: 2px; }
  .slot { height: 10px; background: var(--bar-track); border-radius: 0 4px 4px 0; overflow: hidden; }
  .slot i { display: block; height: 100%; background: var(--bar-fill); border-radius: 0 4px 4px 0; }
  .slot-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li data-id="<%= h(r.article.id) %>"><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= local(r.article.published_at).iso8601 %>"><%= date_label(r.article.published_at) %></time></span></li>
<%- end -%>
</ul>
<footer>Updated <time datetime="<%= local(generated_at).iso8601 %>"><%= datetime_label(generated_at) %></time> · <a href="<%= h(repository_url) %>"><%= h(repository_url.delete_prefix("https://")) %></a> · <a href="?debug=1">debug</a></footer>
<script type="application/json" id="debug-data"><%= debug_json(ranked) %></script>
<script>
  // ?debug=1 draws the ranking factors of every article from the embedded JSON above.
  if (new URLSearchParams(location.search).get("debug")) {
    const f = n => Number(n).toFixed(2);
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const fillOf = value => { const i = el("i"); i.style.width = `${Math.max(0, Math.min(1, value)) * 100}%`; return i; };
    const factorRows = (rows, cls) => {
      const g = el("div", cls ? `dbg-grid ${cls}` : "dbg-grid");
      for (const [label, value] of rows) {
        g.appendChild(el("span", null, label));
        const b = el("div", "bar"); b.title = f(value); b.appendChild(fillOf(value)); g.appendChild(b);
        g.appendChild(el("span", null, f(value)));
      }
      return g;
    };
    // relevance as one bar: each question owns a slot as wide as its weight, filled by its answer.
    const slotBar = (components, judgment) => {
      const wrap = el("div", "slots");
      const bars = el("div", "slots-bars"), labels = el("div", "slots-labels");
      for (const c of components) {
        const slot = el("div", "slot"); slot.style.flexBasis = `${c.weight * 100}%`;
        const probs = judgment.choices[`${c.id}_probabilities`];
        slot.title = probs
          ? `${c.id}: ${Object.entries(probs).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([o, p]) => `${o} ${f(p)}`).join(", ")}`
          : `${c.id}: ${f(c.value)} of weight ${c.weight}`;
        slot.appendChild(fillOf(c.value)); bars.appendChild(slot);
        const label = el("div", "slot-label", `${c.id} ${f(c.value)}`); label.style.flexBasis = `${c.weight * 100}%`; label.title = slot.title;
        labels.appendChild(label);
      }
      wrap.appendChild(bars); wrap.appendChild(labels);
      return wrap;
    };
    {
      const rows = JSON.parse(document.getElementById("debug-data").textContent);
      for (const row of rows) {
        const li = document.querySelector(`li[data-id="${CSS.escape(row.id)}"]`);
        if (!li) continue;
        const box = el("div", "dbg");
        box.appendChild(el("div", null, `${row.source} · ${row.question_set} · ${row.age_hours}h`));
        box.appendChild(factorRows([["score", row.score]], "dbg-final"));
        box.appendChild(el("div", "dbg-h", "= relevance × freshness × exposure"));
        box.appendChild(factorRows([["relevance", row.relevance], ["freshness", row.freshness], ["exposure", row.exposure]]));
        box.appendChild(el("div", "dbg-h", "relevance by question"));
        box.appendChild(slotBar(row.components, row));
        li.appendChild(box);
      }
    }
  }
</script>
</body>
</html>
