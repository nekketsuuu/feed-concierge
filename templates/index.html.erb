<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.2em; margin: 0; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  li > a:visited, li.clicked > a { color: var(--muted); }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
  footer { color: var(--muted); font-size: .75em; margin-top: 1.5rem; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li data-score="<%= r.score.round(4) %>" data-url="<%= h(r.article.url) %>"><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= local(r.article.published_at).iso8601 %>"><%= date_label(r.article.published_at) %></time></span></li>
<%- end -%>
</ul>
<script>
  // Articles clicked here are remembered in localStorage with a TTL and, on the next page load,
  // demoted (score × penalty) but kept on the page. Runs once at load; nothing on history back.
  (() => {
    const KEY = "feed-concierge:clicked", TTL_MS = <%= @site["clicked_ttl_days"] %> * 86400e3, PENALTY = <%= @site["clicked_penalty"] %>;
    const now = Date.now();
    let clicked = {};
    try { clicked = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { clicked = {}; }
    for (const [url, until] of Object.entries(clicked)) if (!(until > now)) delete clicked[url];
    const list = document.querySelector("ul");
    const items = [...list.children];
    if (items.some(li => clicked[li.dataset.url])) {
      const order = items.map((li, i) => ({ li, i, score: Number(li.dataset.score) * (clicked[li.dataset.url] ? PENALTY : 1) }))
        .sort((a, b) => b.score - a.score || a.i - b.i);
      const fragment = document.createDocumentFragment();
      for (const { li } of order) { if (clicked[li.dataset.url]) li.classList.add("clicked"); fragment.appendChild(li); }
      list.appendChild(fragment);
    }
    const remember = event => {
      const li = event.target.closest("li");
      if (!li || !event.target.closest("a") || !list.contains(li)) return;
      clicked[li.dataset.url] = now + TTL_MS;
      try { localStorage.setItem(KEY, JSON.stringify(clicked)); } catch { /* storage unavailable */ }
    };
    list.addEventListener("click", remember, true);
    list.addEventListener("auxclick", remember, true);
  })();
</script>
<footer>Updated <time datetime="<%= local(generated_at).iso8601 %>"><%= datetime_label(generated_at) %></time> · <a href="<%= h(repository_url) %>"><%= h(repository_url.delete_prefix("https://")) %></a> · <a href="tune.html">tune</a></footer>
</body>
</html>
