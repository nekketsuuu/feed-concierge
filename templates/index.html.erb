<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.2em; margin: 0; }
  header p { color: var(--muted); margin: .2rem 0 0; font-size: .8em; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
  .tag-compsci { background: #dfeefc; border-color: #86b4e3; }
  .tag-field { background: #e1f5df; border-color: #7fc47a; }
  .tag-interaction { background: #f1e3f8; border-color: #c48ad9; }
  .tag-practices { background: #fde7d6; border-color: #eba06e; }
  .tag-tools { background: #dbf3f1; border-color: #6fc2ba; }
  @media (prefers-color-scheme: dark) {
    .tag { color: #eee; background: #4a4520; border-color: #8a8230; }
    .tag-compsci { background: #1f3a55; border-color: #4a7fb5; }
    .tag-field { background: #234323; border-color: #4f8f4a; }
    .tag-interaction { background: #3f2650; border-color: #8e5aa8; }
    .tag-practices { background: #4f3220; border-color: #b0693a; }
    .tag-tools { background: #1f4442; border-color: #4a8f88; }
  }
  footer { color: var(--muted); font-size: .75em; margin-top: 1.5rem; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
  <p>Updated <time datetime="<%= generated_at.utc.iso8601 %>"><%= generated_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></time></p>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag tag-<%= h(FeedConcierge::Judge.tag_category(tag)) %>"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= r.article.published_at.utc.iso8601 %>"><%= r.article.published_at.utc.strftime("%m-%d %H:%M") %></time></span></li>
<%- end -%>
</ul>
<footer><a href="data.json">data.json</a></footer>
<script>
  for (const t of document.querySelectorAll("time")) {
    const d = new Date(t.dateTime);
    const pad = n => String(n).padStart(2, "0");
    t.textContent = `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }
</script>
</body>
</html>
