<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(title) %></title>
<style>
  :root { color-scheme: light dark; --muted: #777; }
  body { font: 16px/1.45 system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.2em; margin: 0; }
  ul { list-style: none; padding: 0; margin: 1.2rem 0; }
  li { padding: .45rem 0; border-bottom: 1px solid rgba(127,127,127,.2); }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8em; margin-left: .5rem; white-space: nowrap; }
  .tag { display: inline-block; font-size: .72em; line-height: 1.5; padding: 0 .45em; margin-left: .35rem; border-radius: 4px; border: 1px solid; vertical-align: 2px; color: #333; background: #fffcd7; border-color: #d5d458; }
  footer { color: var(--muted); font-size: .75em; margin-top: 1.5rem; }
  /* Debug view (?debug=1): one hue for 0..1 magnitudes, track = lighter step of the same ramp. */
  :root { --bar-fill: #2a78d6; --bar-track: #cde2fb; }
  @media (prefers-color-scheme: dark) { :root { --bar-fill: #3987e5; --bar-track: #0d366b; } }
  .dbg { margin: .35rem 0 .2rem 1rem; font-size: .78em; color: var(--muted); }
  .dbg span, .dbg div { font-variant-numeric: tabular-nums; }
  /* Waterfall: the score plus what each factor removed, on one 0..1 axis. */
  .wf { display: flex; gap: 2px; height: 14px; margin: .25rem 0 .1rem; }
  .wf-labels { display: flex; gap: 2px; }
  .wf-kept { background: var(--bar-fill); border-radius: 0 4px 4px 0; }
  .wf-loss { background: var(--bar-track); border-radius: 0 4px 4px 0; }
  .wf-labels div, .slot-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wf-labels div:first-child { color: inherit; font-weight: 600; }
  /* Explain tree: value bar, then how it was derived, indented under its parent. */
  .node { margin-top: .4rem; padding-left: .6rem; border-left: 2px solid rgba(127,127,127,.25); }
  .node-head { display: grid; grid-template-columns: 6em 120px auto; column-gap: .6rem; align-items: center; }
  .node-head span:first-child { color: inherit; }
  .node-how { margin: .1rem 0 0; }
  .bar { position: relative; height: 8px; background: var(--bar-track); border-radius: 0 4px 4px 0; }
  .bar i { display: block; height: 100%; background: var(--bar-fill); border-radius: 0 4px 4px 0; }
  .slots { margin: .2rem 0 0; }
  .slots-bars, .slots-labels { display: flex; gap: 2px; }
  .slot { height: 10px; background: var(--bar-track); border-radius: 0 4px 4px 0; overflow: hidden; }
  .slot i { display: block; height: 100%; background: var(--bar-fill); border-radius: 0 4px 4px 0; }
</style>
</head>
<body>
<header>
  <h1><%= h(title) %></h1>
</header>
<ul>
<%- ranked.each do |r| -%>
  <li data-id="<%= h(r.article.id) %>"><a href="<%= h(r.article.url) %>"><%= h(r.article.title) %></a><%- tags_for(r).each do |tag| -%><span class="tag"><%= h(tag) %></span><%- end -%><span class="meta"><%= h(r.article.domain) %> · <time datetime="<%= local(r.article.published_at).iso8601 %>"><%= date_label(r.article.published_at) %></time></span></li>
<%- end -%>
</ul>
<footer>Updated <time datetime="<%= local(generated_at).iso8601 %>"><%= datetime_label(generated_at) %></time> · <a href="<%= h(repository_url) %>"><%= h(repository_url.delete_prefix("https://")) %></a> · <a href="?debug=1">debug</a></footer>
<script type="application/json" id="debug-data"><%= debug_json(ranked) %></script>
<script>
  // ?debug=1 explains each article's score: a waterfall of what each factor removed, then an
  // explain tree (value, how it was derived, what-if) for relevance, freshness, and exposure.
  if (new URLSearchParams(location.search).get("debug")) {
    const f = n => Number(n).toFixed(2);
    const pct = v => `${Math.max(0, Math.min(1, v)) * 100}%`;
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const fillOf = value => { const i = el("i"); i.style.width = pct(value); return i; };
    const flexRow = (cls, parts) => {
      const row = el("div", cls);
      for (const [width, node, title] of parts) { node.style.flexBasis = pct(width); node.style.flexShrink = "0"; if (title) node.title = title; row.appendChild(node); }
      return row;
    };
    // score = 1 × relevance × freshness × exposure, attributed in that order.
    const waterfall = row => {
      const steps = [["relevance", row.relevance], ["freshness", row.freshness], ["exposure", row.exposure]];
      let running = 1, parts = [], labels = [];
      for (const [name, factor] of steps) { const loss = running * (1 - factor); parts.push([loss, el("div", "wf-loss"), `${name} removed ${f(loss)}`]); labels.push([loss, el("div", null, `−${f(loss)} ${name}`), `${name} ${f(factor)}`]); running *= factor; }
      parts.unshift([running, el("div", "wf-kept"), `score ${f(running)}`]); labels.unshift([running, el("div", null, `score ${f(running)}`)]);
      const wrap = el("div"); wrap.appendChild(flexRow("wf", parts)); wrap.appendChild(flexRow("wf-labels", labels));
      return wrap;
    };
    const node = (name, value, how) => {
      const n = el("div", "node");
      const head = el("div", "node-head"); head.appendChild(el("span", null, name));
      const b = el("div", "bar"); b.title = f(value); b.appendChild(fillOf(value)); head.appendChild(b); head.appendChild(el("span", null, f(value)));
      n.appendChild(head); if (how) n.appendChild(el("div", "node-how", how));
      return n;
    };
    // relevance: one slot per question, as wide as its weight, filled by the answer.
    const slotBar = row => {
      const bars = [], labels = [];
      for (const c of row.components) {
        const probs = row.choices[`${c.id}_probabilities`];
        const title = probs ? `${c.id}: ` + Object.entries(probs).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([o, p]) => `${o} ${f(p)}`).join(", ") : `${c.id}: answer ${f(c.value)}, weight ${c.weight}`;
        const slot = el("div", "slot"); slot.appendChild(fillOf(c.value));
        bars.push([c.weight, slot, title]); labels.push([c.weight, el("div", "slot-label", `${c.id} ${f(c.value)}`), title]);
      }
      const wrap = el("div", "slots"); wrap.appendChild(flexRow("slots-bars", bars)); wrap.appendChild(flexRow("slots-labels", labels));
      return wrap;
    };
    const rows = JSON.parse(document.getElementById("debug-data").textContent);
    for (const row of rows) {
      const li = document.querySelector(`li[data-id="${CSS.escape(row.id)}"]`);
      if (!li) continue;
      const x = row.explain, fr = x.freshness, ex = x.exposure;
      const box = el("div", "dbg");
      box.appendChild(el("div", null, `${row.source} · ${row.question_set} · ${row.age_hours}h`));
      box.appendChild(waterfall(row));
      const rel = node("relevance", row.relevance, "Σ weight × answer");
      rel.appendChild(slotBar(row)); box.appendChild(rel);
      box.appendChild(node("freshness", row.freshness,
        `age ${fr.age_hours}h · half-life ${fr.half_life_hours}h = ${fr.base_half_life_hours}h + ${fr.bonus_hours}h × evergreen ${f(fr.evergreen)} · ` +
        `if evergreen were 0 → ${f(fr.if_evergreen_zero)}, 1 → ${f(fr.if_evergreen_one)}`));
      box.appendChild(node("exposure", row.exposure,
        ex.days_shown == null ? "never shown on the page yet" : `first shown ${ex.days_shown}d ago · halves every ${ex.half_life_days}d`));
      li.appendChild(box);
    }
  }
</script>
</body>
</html>
